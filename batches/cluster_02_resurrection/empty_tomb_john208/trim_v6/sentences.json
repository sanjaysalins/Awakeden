[
 {
  "id": "S00",
  "start": 0.08,
  "end": 1.06,
  "text": "Someone took the body."
 },
 {
  "id": "S01",
  "start": 2.08,
  "end": 4.401,
  "text": "That was Mary's first thought at the empty tomb of Jesus."
 },
 {
  "id": "S02",
  "start": 4.581,
  "end": 9.181,
  "text": "The first day of the week, while it was still dark, Mary Magdalene found the stone rolled away —"
 },
 {
  "id": "S03",
  "start": 9.501,
  "end": 10.702,
  "text": "and ran to Peter and John:"
 },
 {
  "id": "S04",
  "start": 11.262,
  "end": 15.822,
  "text": "They have taken away the Lord out of the sepulchre, and we know not where they have laid him."
 },
 {
  "id": "S05",
  "start": 16.162,
  "end": 16.602,
  "text": "They ran."
 },
 {
  "id": "S06",
  "start": 17.423,
  "end": 18.203,
  "text": "The body was gone."
 },
 {
  "id": "S07",
  "start": 18.743,
  "end": 19.343,
  "text": "Only the linen —"
 },
 {
  "id": "S08",
  "start": 19.603,
  "end": 20.863,
  "text": "and the cloth that had covered his head:"
 },
 {
  "id": "S09",
  "start": 21.863,
  "end": 28.084,
  "text": "And the napkin, that was about his head, not lying with the linen clothes, but wrapped together in a place by itself."
 },
 {
  "id": "S10",
  "start": 28.544,
  "end": 30.825,
  "text": "What thief wraps the face-cloth and lays it aside?"
 },
 {
  "id": "S11",
  "start": 30.925,
  "end": 32.145,
  "text": "Then John stepped inside."
 },
 {
  "id": "S12",
  "start": 33.245,
  "end": 33.705,
  "text": "No angel."
 },
 {
  "id": "S13",
  "start": 34.445,
  "end": 35.125,
  "text": "No risen Lord."
 },
 {
  "id": "S14",
  "start": 36.165,
  "end": 38.966,
  "text": "Only the linen, lying where the body should have been."
 },
 {
  "id": "S15",
  "start": 40.026,
  "end": 41.346,
  "text": "The gospel says only this:"
 },
 {
  "id": "S16",
  "start": 42.026,
  "end": 43.946,
  "text": "and he saw, and believed."
 },
 {
  "id": "S17",
  "start": 44.427,
  "end": 45.047,
  "text": "Believed what?"
 },
 {
  "id": "S18",
  "start": 45.727,
  "end": 46.767,
  "text": "That his Lord was risen."
 },
 {
  "id": "S19",
  "start": 47.727,
  "end": 49.107,
  "text": "He did not yet know the scripture —"
 },
 {
  "id": "S20",
  "start": 49.427,
  "end": 51.028,
  "text": "that Christ must rise from the dead."
 },
 {
  "id": "S21",
  "start": 51.928,
  "end": 52.988,
  "text": "The linen was enough."
 },
 {
  "id": "S22",
  "start": 53.148,
  "end": 55.008,
  "text": "Thomas refused to believe until he saw."
 },
 {
  "id": "S23",
  "start": 55.688,
  "end": 58.149,
  "text": "Eight days later the risen Jesus showed him his hands —"
 },
 {
  "id": "S24",
  "start": 58.849,
  "end": 60.509,
  "text": "Thomas saw, and believed."
 },
 {
  "id": "S25",
  "start": 61.429,
  "end": 62.209,
  "text": "Then Jesus said:"
 },
 {
  "id": "S26",
  "start": 62.749,
  "end": 67.05,
  "text": "blessed are they that have not seen, and yet have believed."
 },
 {
  "id": "S27",
  "start": 67.49,
  "end": 68.41,
  "text": "You were not at the tomb."
 },
 {
  "id": "S28",
  "start": 69.07,
  "end": 69.97,
  "text": "You never saw the linen."
 },
 {
  "id": "S29",
  "start": 70.77,
  "end": 72.111,
  "text": "Jesus was speaking about you."
 },
 {
  "id": "S30",
  "start": 72.971,
  "end": 74.591,
  "text": "Believe what John believed at the linen —"
 },
 {
  "id": "S31",
  "start": 75.131,
  "end": 76.271,
  "text": "the Lord is risen."
 },
 {
  "id": "S32",
  "start": 77.151,
  "end": 78.972,
  "text": "Already, he calls that faith blessed."
 }
]