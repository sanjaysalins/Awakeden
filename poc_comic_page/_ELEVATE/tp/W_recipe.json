  "overlays": [
    {"kind": "stamp", "text": "SAME NAILS", "t0": 2.90, "t1": 3.95, "speaker": "narrator", "top": 120, "tail": null, "hi": []},
    {"kind": "stamp", "text": "SAME HILL", "t0": 4.04, "t1": 5.10, "speaker": "narrator", "top": 120, "tail": null, "hi": []},
    {"kind": "stamp", "text": "SAME DISTANCE", "t0": 5.20, "t1": 6.70, "speaker": "narrator", "top": 905, "tail": null, "hi": []},
    {"kind": "jag", "text": "If thou be Christ, save thyself and us.", "t0": 12.04, "t1": 15.10, "speaker": "mocker", "top": 60, "tail": [483, 630], "hi": []},
    {"kind": "ref", "text": "LUKE 23:39", "t0": 12.04, "t1": 15.10, "speaker": "narrator", "top": 1820, "tail": null, "hi": []},
    {"kind": "caption", "text": "A taunt, not a prayer.", "t0": 15.30, "t1": 17.00, "speaker": "narrator", "top": 1500, "tail": null, "hi": []},
    {"kind": "round", "text": "And we indeed justly;", "t0": 18.82, "t1": 20.28, "speaker": "thief", "top": 1420, "tail": [555, 1190], "hi": []},
    {"kind": "ref", "text": "LUKE 23:40-41", "t0": 18.82, "t1": 27.36, "speaker": "narrator", "top": 1820, "tail": null, "hi": []},
    {"kind": "round", "text": "for we receive the due reward of our deeds:", "t0": 20.30, "t1": 23.38, "speaker": "thief", "top": 1440, "tail": [480, 1320], "hi": []},
    {"kind": "round", "text": "but this man hath done nothing amiss.", "t0": 23.40, "t1": 27.36, "speaker": "thief", "top": 40, "tail": [462, 540], "hi": []},
    {"kind": "caption", "text": "A confession.", "t0": 27.40, "t1": 28.10, "speaker": "narrator", "top": 1500, "tail": null, "hi": []},
    {"kind": "caption", "text": "A verdict: innocent.", "t0": 28.14, "t1": 29.55, "speaker": "narrator", "top": 1500, "tail": null, "hi": ["innocent"]},
    {"kind": "caption", "text": "Then one request.", "t0": 30.55, "t1": 31.95, "speaker": "narrator", "top": 1500, "tail": null, "hi": []},
    {"kind": "round", "text": "Lord, remember me when thou comest into thy kingdom.", "t0": 32.01, "t1": 35.90, "speaker": "thief", "top": 20, "tail": [503, 640], "hi": ["remember", "me"]},
    {"kind": "ref", "text": "LUKE 23:42", "t0": 32.01, "t1": 35.90, "speaker": "narrator", "top": 1820, "tail": null, "hi": []},
    {"kind": "light", "text": "Verily I say unto thee,", "t0": 36.37, "t1": 38.35, "speaker": "jesus", "top": 1450, "tail": null, "hi": []},
    {"kind": "ref", "text": "LUKE 23:43", "t0": 36.37, "t1": 41.07, "speaker": "narrator", "top": 1820, "tail": null, "hi": []},
    {"kind": "light", "text": "To day shalt thou be with me in paradise.", "t0": 38.40, "t1": 41.40, "speaker": "jesus", "top": 1450, "tail": null, "hi": ["To", "day", "paradise"]},
    {"kind": "caption", "text": "He asked for someday.", "t0": 41.75, "t1": 43.75, "speaker": "narrator", "top": 1500, "tail": null, "hi": ["someday"]},
    {"kind": "caption", "text": "Jesus gave him that same afternoon.", "t0": 44.60, "t1": 47.00, "speaker": "narrator", "top": 1500, "tail": null, "hi": ["same", "afternoon"]},
    {"kind": "caption", "text": "No merit. Just repentance and trust.", "t0": 47.05, "t1": 49.45, "speaker": "narrator", "top": 1450, "tail": null, "hi": []},
    {"kind": "caption", "text": "We are all one of those two men.", "t0": 49.50, "t1": 51.60, "speaker": "narrator", "top": 1560, "tail": null, "hi": []},
    {"kind": "round", "text": "Remember me.", "t0": 52.25, "t1": 53.85, "speaker": "thief", "top": 1150, "tail": [890, 830], "hi": []},
    {"kind": "light", "text": "With me.", "t0": 55.85, "t1": 57.05, "speaker": "jesus", "top": 1200, "tail": null, "hi": []},
    {"kind": "light", "text": "Today.", "t0": 57.05, "t1": 59.07, "speaker": "jesus", "top": 1150, "tail": null, "hi": []},
    {"kind": "light", "text": "Paradise.", "t0": 58.50, "t1": 59.07, "speaker": "jesus", "top": 1330, "tail": null, "hi": []}
  ]
}
