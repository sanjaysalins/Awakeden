    0.42
   ]
  ],
  "_panel_slide": [
   "left",
   "up",
   "right"
  ],
  "flash": true
 },
 {
  "start": "And Jesus reaches",
  "tpl": "full",
  "clips": [
   {
    "slug": "23_himself",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "And Jesus reaches back, past the temple, past the law, to a snake on a pole in the desert.",
   "kw": "REACHES BACK"
  }
 },
 {
  "start": "And as Moses",
  "tpl": "full",
  "clips": [
   {
    "slug": "12_even_so_must_the_son_of_man_be_lifted_up"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "JESUS",
   "ref": "John 3:14-15",
   "text": "And as Moses lifted up the serpent in the wilderness, even so must the Son of man be lifted up: That whosoever believeth in him should not perish, but have eternal life."
  }
 },
 {
  "start": "Stop on",
  "tpl": "two_v",
  "clips": [
   {
    "slug": "reuse_jesus_looks_down"
   },
   {
    "slug": "reuse_face_on_cross"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Stop on that. This is not a preacher centuries later finding a clever picture in the Old Testament.",
   "kw": "STOP ON THAT"
  }
 },
 {
  "start": "This is Jesus",
  "tpl": "full",
  "clips": [
   {
    "slug": "13_lifted_up__signifying_what_death_he_should_die",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "This is Jesus Himself, naming that pole as a portrait of His own cross.",
   "kw": "PORTRAIT"
  },
  "punch": true
 },
 {
  "start": "And He means",
  "tpl": "full",
  "clips": [
   {
    "slug": "13_lifted_up__signifying_what_death_he_should_die",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "And He means it precisely. Later, John tells us what that phrase pointed to.",
   "kw": "PRECISELY"
  }
 },
 {
  "start": "And I, if",
  "tpl": "triptych_v",
  "clips": [
   {
    "slug": "reuse_nail_through_hand"
   },
   {
    "slug": "13_lifted_up__signifying_what_death_he_should_die",
    "cam": "swoop"
   },
   {
    "slug": "reuse_golgotha_hill_wide"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "JESUS",
   "ref": "John 12:32",
   "text": "And I, if I be lifted up from the earth, will draw all men unto me."
  }
 },
 {
  "start": "This he said",
  "tpl": "full",
  "clips": [
   {
    "slug": "reuse_darkness_veil_torn"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "SCRIPTURE",
   "ref": "John 12:33",
   "text": "This he said, signifying what death he should die."
  }
 },
 {
  "start": "Lifted up",
  "tpl": "two_v",
  "clips": [
   {
    "slug": "reuse_two_thieves_wide"
   },
   {
    "slug": "reuse_cross_at_dawn"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Lifted up was the cross. By Jesus' own word, the wilderness pole was a picture of Calvary.",
   "kw": "CALVARY"
  }
 },
 {
  "start": "And the passage",
  "tpl": "full",
  "clips": [
   {
    "slug": "14_for_god_so_loved_the_world",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "And the passage flows straight on into the verse the whole world knows.",
   "kw": "WHOLE WORLD"
  }
 },
 {
  "start": "For God so loved",
  "tpl": "full",
  "clips": [
   {
    "slug": "14_for_god_so_loved_the_world"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "SCRIPTURE",
   "ref": "John 3:16",
   "text": "For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have eternal life."
  }
 },
 {
  "start": "The snake on",
  "tpl": "big_inset",
  "clips": [
   {
    "slug": "08_raised",
    "cam": "arc"
   },
   {
    "slug": "reuse_grace_poured_sky"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "The snake on the pole and God so loved the world sit in the same breath of Scripture.",
   "kw": "SAME BREATH"
  }
 },
 {
  "start": "Now, be fair",
  "tpl": "full",
  "clips": [
   {
    "slug": "24_trust",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Now, be fair to the doubts, because there are two.",
   "kw": "TWO DOUBTS"
  }
 },
 {
  "start": "First: doesn't",
  "tpl": "full",
  "clips": [
   {
    "slug": "24_trust",
    "cam": "swoop"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "First: doesn't a bronze snake on a pole just become an idol? Scripture itself answers that, bluntly.",
   "kw": "IDOL"
  }
 },
 {
  "start": "Centuries later",
  "tpl": "full",
  "clips": [
   {
    "slug": "15_hezekiah_breaks_the_brazen_serpent",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Centuries later Israel did begin burning incense to it, and a godly king named Hezekiah",
   "kw": "HEZEKIAH"
  }
 },
 {
  "start": "brake in pieces",
  "tpl": "full",
  "clips": [
   {
    "slug": "15_hezekiah_breaks_the_brazen_serpent"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "2 KINGS 18",
   "ref": "2 Kings 18:4",
   "text": "brake in pieces the brasen serpent that Moses had made."
  },
  "punch": true
 },
 {
  "start": "The bronze never",
  "tpl": "full",
  "clips": [
   {
    "slug": "24_trust",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "The bronze never had power; God did. Looking was never magic, it was trust.",
   "kw": "TRUST"
  }
 },
 {
  "start": "aimed where",
  "tpl": "two_v",
  "clips": [
   {
    "slug": "reuse_jesus_looks_down"
   },
   {
    "slug": "reuse_hands_of_light_open"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Aimed where God told them to aim it. Scripture smashes the relic itself, so you never mistake the sign for the Savior.",
   "kw": "NOT THE SIGN"
  }
 },
 {
  "start": "Second, and",
  "tpl": "full",
  "clips": [
   {
    "slug": "16_the_likeness_of_the_curse_lifted_up",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Second, and deeper: isn't a serpent a strange picture of Christ?",
   "kw": "STRANGE PICTURE"
  }
 },
 {
  "start": "In the Bible",
  "tpl": "full",
  "clips": [
   {
    "slug": "16_the_likeness_of_the_curse_lifted_up",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "In the Bible the serpent is the tempter and the curse. Exactly, and that is the point, not the problem.",
   "kw": "THE POINT"
  }
 },
 {
  "start": "What hung on",
  "tpl": "two_v",
  "clips": [
   {
    "slug": "16_the_likeness_of_the_curse_lifted_up",
    "cam": "push"
   },
   {
    "slug": "reuse_bowed_head_finished"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "What hung on that pole was the likeness of the very thing killing them.",
   "kw": "LIKENESS"
  }
 },
 {
  "start": "what hung on the cross",
  "tpl": "full",
  "clips": [
   {
    "slug": "17_made_a_curse_for_us__on_the_tree",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "What hung on the cross was the One of whom Scripture says God",
   "kw": "OF WHOM SCRIPTURE SAYS"
  }
 },
 {
  "start": "hath made him",
  "tpl": "full",
  "clips": [
   {
    "slug": "17_made_a_curse_for_us__on_the_tree"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "2 CORINTHIANS 5",
   "ref": "2 Corinthians 5:21",
   "text": "hath made him to be sin for us, who knew no sin."
  }
 },
 {
  "start": "being made",
  "tpl": "triptych_v",
  "clips": [
   {
    "slug": "reuse_nail_through_hand"
   },
   {
    "slug": "17_made_a_curse_for_us__on_the_tree",
    "cam": "arc"
   },
   {
    "slug": "reuse_darkness_veil_torn"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "GALATIANS 3",
   "ref": "Galatians 3:13",
   "text": "being made a curse for us: for it is written, Cursed is every one that hangeth on a tree."
  }
 },
 {
  "start": "Christ did not",
  "tpl": "full",
  "clips": [
   {
    "slug": "18_curse",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Christ did not become a sinner. He was lifted up bearing our curse, in the likeness of the judgment we deserved.",
   "kw": "BEARING OUR CURSE"
  },
  "punch": true
 },
 {
  "start": "so the look",
  "tpl": "full",
  "clips": [
   {
    "slug": "18_curse",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "So the look of faith could find it there and live. This is not a stretch; it is the meaning Jesus put there Himself.",
   "kw": "MEANING JESUS PUT THERE"
  }
 },
 {
  "start": "So hold the two",
  "tpl": "two_v",
  "clips": [
   {
    "slug": "22_curse",
    "cam": "swoop"
   },
   {
    "slug": "reuse_golgotha_hill_wide"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "So hold the two scenes together. In the wilderness the cure was never in the dying man.",
   "kw": "NEVER IN HIM"
  }
 },
 {
  "start": "he could not",
  "tpl": "full",
  "clips": [
   {
    "slug": "19_look",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "He could not neutralize the venom or earn his way back to health. It hung entirely outside him, on a pole.",
   "kw": "OUTSIDE HIM"
  }
 },
 {
  "start": "That is the cross",
  "tpl": "big_inset",
  "clips": [
   {
    "slug": "25_we_are_all_bitten__the_cure_outside_us",
    "cam": "push"
   },
   {
    "slug": "reuse_face_on_cross"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "That is the cross. We are all bitten; the poison of sin is already in us, and no self-improvement reaches it.",
   "kw": "ALL BITTEN"
  }
 },
 {
  "start": "So God lifted",
  "tpl": "full",
  "clips": [
   {
    "slug": "25_we_are_all_bitten__the_cure_outside_us",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "So God lifted up His Son, who",
   "kw": "LIFTED UP HIS SON"
  }
 },
 {
  "start": "his own self",
  "tpl": "full",
  "clips": [
   {
    "slug": "16_the_likeness_of_the_curse_lifted_up",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "1 PETER 2",
   "ref": "1 Peter 2:24",
   "text": "his own self bare our sins in his own body on the tree."
  }
 },
 {
  "start": "The curse fell",
  "tpl": "two_v",
  "clips": [
   {
    "slug": "reuse_us_under_cross_shadow"
   },
   {
    "slug": "18_curse",
    "cam": "swoop"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "The curse fell on the lifted One, so that everyone who looks to Him might live.",
   "kw": "FELL ON HIM"
  }
 },
 {
  "start": "It cost the",
  "tpl": "full",
  "clips": [
   {
    "slug": "26_strong",
    "cam": "push"
   }
  ],
  "cap": {
