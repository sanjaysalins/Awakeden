  "flash": true
 },
 {
  "start": "Now move",
  "tpl": "two_v",
  "clips": [
   {
    "slug": "01_snakebite",
    "cam": "swoop"
   },
   {
    "slug": "03_the_lord_sent_fiery_serpents__and_people_died",
    "cam": "swoop"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Now move forward roughly fourteen hundred years.",
   "kw": "FOURTEEN HUNDRED"
  }
 },
 {
  "start": "into a quiet",
  "tpl": "hero_frac3",
  "clips": [
   {
    "slug": "11_night"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Into a quiet night-time conversation. A religious leader named Nicodemus has come to Jesus in the dark, trying to understand who He is.",
   "kw": "NICODEMUS"
  },
  "anchors": [
   [
    1.0,
    0.5,
    0.42
   ],
   [
    1.9,
