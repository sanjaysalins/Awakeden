[
 {
  "start": "A whole",
  "tpl": "full",
  "clips": [
   {
    "slug": "01_snakebite",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "A whole camp is dying of snakebite.",
   "kw": "SNAKEBITE"
  },
  "punch": true
 },
 {
  "start": "and God's",
  "tpl": "full",
  "clips": [
   {
    "slug": "04_venom"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "God's remedy is not to kill the snakes, or heal the wounds, or hand out an antidote.",
   "kw": "REMEDY"
  },
  "inserts": [
   {
    "at_frac": 0.55,
    "slug": "08_raised",
    "frames": 4
   }
  ]
 },
 {
  "start": "He tells",
  "tpl": "full",
  "clips": [
   {
    "slug": "08_raised",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "He tells them to look at a piece of metal on a pole. Look, and live.",
   "kw": "LOOK"
  },
  "ramp": true
 },
 {
  "start": "It is one",
  "tpl": "full",
  "clips": [
   {
    "slug": "08_raised",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "It is one of the strangest cures in the Bible.",
   "kw": "STRANGEST"
  }
 },
 {
  "start": "It happens",
  "tpl": "hero_frac3",
  "clips": [
   {
    "slug": "02_worn_down_they_despise_the_bread_of_heaven"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "It happens near the end of the wilderness years. Israel is worn down by the long road, and the old bitterness boils over.",
   "kw": "BOILS OVER"
  },
  "anchors": [
   [
    1.0,
    0.42,
    0.42
   ],
   [
    1.9,
    0.2,
    0.62
   ],
   [
    1.9,
    0.62,
    0.42
   ]
  ],
  "_panel_slide": [
   "left",
   "up",
   "right"
  ],
  "flash": true
 },
 {
  "start": "Wherefore have",
  "tpl": "full",
  "clips": [
   {
    "slug": "03_the_lord_sent_fiery_serpents__and_people_died",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "THE PEOPLE",
   "ref": "Numbers 21:5",
   "text": "Wherefore have ye brought us up out of Egypt to die in the wilderness? for there is no bread, neither is there any water; and our soul loatheth this light bread."
  },
  "takeover": {
   "panel": 0,
   "start_frac": 0.75,
   "zoom": 1.25
  }
 },
 {
  "start": "And the LORD sent",
  "tpl": "full",
  "clips": [
   {
    "slug": "03_the_lord_sent_fiery_serpents__and_people_died",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "NUMBERS 21",
   "ref": "Numbers 21:6",
   "text": "And the LORD sent fiery serpents among the people, and they bit the people; and much people of Israel died."
  }
 },
 {
  "start": "Picture the",
  "tpl": "hero_frac3",
  "clips": [
   {
    "slug": "05_they_beg_moses_take_the_serpents_away"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "THE PEOPLE",
   "ref": "Numbers 21:7",
   "text": "We have sinned, for we have spoken against the LORD, and against thee; pray unto the LORD, that he take away the serpents from us."
  },
  "anchors": [
   [
    1.0,
    0.35,
    0.5
   ],
   [
    1.8,
    0.18,
    0.72
   ],
   [
    1.8,
    0.62,
    0.68
   ]
  ],
  "_panel_slide": [
   "left",
   "up",
   "right"
  ],
  "flash": true
 },
 {
  "start": "Their confession",
  "tpl": "full",
  "clips": [
   {
    "slug": "27_outward",
    "cam": "push"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Their confession is real. They name the sin itself. But look at the cure they ask for: take away the serpents, make the threat go away.",
   "kw": "CONFESSION"
  },
  "punch": true
 },
 {
  "start": "Even as they",
  "tpl": "full",
  "clips": [
   {
    "slug": "27_outward",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Even as they confess, their request reaches only for the danger outside.",
   "kw": "OUTWARD"
  }
 },
 {
  "start": "Now watch",
  "tpl": "full",
  "clips": [
   {
    "slug": "06_not",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Now watch what God actually does, because He does not do what they asked.",
   "kw": "NOT"
  }
 },
 {
  "start": "Make thee",
  "tpl": "full",
  "clips": [
   {
    "slug": "07_make_a_fiery_serpent_set_it_on_a_pole"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "THE LORD",
   "ref": "Numbers 21:8",
   "text": "Make thee a fiery serpent, and set it upon a pole: and it shall come to pass, that every one that is bitten, when he looketh upon it, shall live."
  }
 },
 {
  "start": "Sit with",
  "tpl": "full",
  "clips": [
   {
    "slug": "22_curse",
    "cam": "swoop"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "Sit with how strange that is. The cure is shaped like the curse.",
   "kw": "CURSE"
  },
  "punch": true
 },
 {
  "start": "The thing lifted",
  "tpl": "full",
  "clips": [
   {
    "slug": "22_curse",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "The thing lifted up is a serpent, a bronze likeness of the very thing killing them, raised on a pole for all to see.",
   "kw": "LIKENESS"
  }
 },
 {
  "start": "And the cure",
  "tpl": "full",
  "clips": [
   {
    "slug": "08_raised",
    "cam": "arc"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "And the cure costs the bitten man nothing he can boast in.",
   "kw": "NOTHING"
  }
 },
 {
  "start": "Every one",
  "tpl": "full",
  "clips": [
   {
    "slug": "08_raised"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "THE LORD",
   "ref": "Numbers 21:8b",
   "text": "Every one that is bitten, when he looketh upon it, shall live."
  }
 },
 {
  "start": "One act",
  "tpl": "full",
  "clips": [
   {
    "slug": "09_look"
   }
  ],
  "cap": {
   "type": "caption",
   "text": "One act. Look.",
   "kw": "LOOK"
  },
  "punch": true
 },
 {
  "start": "And Moses made",
  "tpl": "hero_frac3",
  "clips": [
   {
    "slug": "10_and_moses_made_a_serpent_of_brass_the_camp_looks"
   }
  ],
  "cap": {
   "type": "redletter",
   "speaker": "NUMBERS 21",
   "ref": "Numbers 21:9",
   "text": "And Moses made a serpent of brass, and put it upon a pole, and it came to pass, that if a serpent had bitten any man, when he beheld the serpent of brass, he lived."
  },
