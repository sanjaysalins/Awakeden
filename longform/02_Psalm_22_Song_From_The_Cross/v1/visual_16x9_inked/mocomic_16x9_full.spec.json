      "cap": {"type": "redletter", "text": "My God, my God, why hast thou forsaken me?", "speaker": "JESUS", "ref": "Matthew 27:46"}},
    {"t": [16.0, 22.5], "tpl": "two_v",     "clips": [{"slug": "david_psalmist", "motion": "pushin", "cam": "arc"}, {"slug": "scribe_over_manuscripts", "motion": "static"}],
      "cap": {"type": "caption", "text": "Written down a thousand years before.", "kw": "A THOUSAND YEARS"}},
    {"t": [22.5, 30.0], "tpl": "big_inset", "clips": [{"slug": "david_old_deathbed", "motion": "pushin", "cam": "swoop"}, {"slug": "david_psalmist", "motion": "pushin"}],
      "cap": {"type": "caption", "text": "By a king who died old and safe in his own bed.", "kw": "DIED OLD"}},
    {"t": [30.0, 38.0], "tpl": "full",      "clips": [{"slug": "convergence_on_cross", "motion": "pushin", "cam": "swoop"}],
      "cap": {"type": "redletter", "text": "Why art thou so far from helping me?", "speaker": "PSALM 22", "ref": "v.1"}},
    {"t": [38.0, 44.9], "tpl": "quad",      "clips": [{"slug": "pierced_hands_feet", "motion": "pushin"}, {"slug": "poured_out_bones", "motion": "pushin"}, {"slug": "mockers_wag_heads", "motion": "pushin"}, {"slug": "storm_over_jerusalem", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "caption", "text": "This is Psalm twenty-two.", "kw": "PSALM 22"}},

    {"t": [44.9, 66.0], "tpl": "two_v",     "clips": [{"slug": "david_psalmist", "motion": "pushin", "cam": "arc"}, {"slug": "david_hands_lyre", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "caption", "text": "David wrote it as if it happened to his own body.", "kw": "HIS OWN BODY"}},
    {"t": [66.0, 77.0], "tpl": "big_inset", "clips": [{"slug": "worm_reproach", "motion": "pushin", "cam": "swoop"}, {"slug": "worm_lowest", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "But I am a worm, and no man; a reproach of men, and despised of the people.", "speaker": "PSALM 22", "ref": "v.6"}},
    {"t": [77.0, 96.0], "tpl": "big_inset", "clips": [{"slug": "mockers_wag_heads", "motion": "pushin", "cam": "arc"}, {"slug": "mocker_faces_trio", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "He trusted on the LORD that he would deliver him: let him deliver him.", "speaker": "THE MOCKERS", "ref": "Psalm 22:8"}},
    {"t": [96.0, 111.0], "tpl": "full",     "clips": [{"slug": "poured_out_bones", "motion": "pushin", "cam": "swoop"}],
      "cap": {"type": "redletter", "text": "I am poured out like water, and all my bones are out of joint.", "speaker": "PSALM 22", "ref": "v.14"}},
    {"t": [111.0, 124.8], "tpl": "big_inset","clips": [{"slug": "thirst_dust", "motion": "pushin", "cam": "swoop"}, {"slug": "cry_face_tears", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "My tongue cleaveth to my jaws; and thou hast brought me into the dust of death.", "speaker": "PSALM 22", "ref": "v.15"}},
    {"t": [124.8, 145.6], "tpl": "big_inset","clips": [{"slug": "pierced_hands_feet", "motion": "pushin", "cam": "swoop"}, {"slug": "pierced_feet", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "They pierced my hands and my feet.", "speaker": "PSALM 22", "ref": "v.16"}},
    {"t": [145.6, 156.0], "tpl": "two_v",   "clips": [{"slug": "lots_dice_closeup", "src": "new", "motion": "pushin", "cam": "arc"}, {"slug": "crane_cross_soldiers", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "They part my garments among them, and cast lots upon my vesture.", "speaker": "PSALM 22", "ref": "v.18"}},
    {"t": [156.0, 167.0], "tpl": "two_v",   "clips": [{"slug": "crane_cross_soldiers", "motion": "pushin", "cam": "arc"}, {"slug": "lots_dice_closeup", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "They parted my raiment among them, and for my vesture they did cast lots.", "speaker": "JOHN", "ref": "19:24"}},
    {"t": [167.0, 182.0], "tpl": "two_v",   "clips": [{"slug": "scribe_over_manuscripts", "motion": "static", "cam": "arc"}, {"slug": "scholar_hand_on_text", "src": "new", "motion": "static", "cam": "arc"}],
      "cap": {"type": "caption", "text": "An honest objection deserves a straight answer.", "kw": "HONEST OBJECTION"}},
    {"t": [182.0, 193.0], "tpl": "big_inset","clips": [{"slug": "disputed_word_marks", "motion": "static", "cam": "arc"}, {"slug": "two_scrolls_compared", "src": "new", "motion": "static", "cam": "arc"}],
      "cap": {"type": "caption", "text": "On one word, pierced, there is a real dispute.", "kw": "ONE WORD"}},
    {"t": [193.0, 216.0], "tpl": "quad",    "clips": [{"slug": "poured_out_bones", "motion": "pushin"}, {"slug": "thirst_dust", "motion": "pushin"}, {"slug": "mockers_wag_heads", "motion": "pushin"}, {"slug": "pierced_hands_feet", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "caption", "text": "One disputed word does not carry it. The convergence does.", "kw": "THE CONVERGENCE"}},
    {"t": [216.0, 234.0], "tpl": "big_inset","clips": [{"slug": "greek_ot_scroll", "motion": "static", "cam": "arc"}, {"slug": "two_scrolls_compared", "src": "new", "motion": "static", "cam": "arc"}],
      "cap": {"type": "caption", "text": "The Greek Old Testament already read it: pierced.", "kw": "PIERCED"}},
    {"t": [234.0, 251.0], "tpl": "big_inset","clips": [{"slug": "storm_over_jerusalem", "motion": "pushin", "cam": "swoop"}, {"slug": "cross_hill_pullback", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "caption", "text": "Back to the cross, and why that cry matters.", "kw": "THE CROSS"}},
    {"t": [251.0, 260.0], "tpl": "full",    "clips": [{"slug": "face_anguish_closeup", "src": "new", "motion": "pushin"}],
      "cap": {"type": "caption", "text": "He placed himself as the I of Psalm twenty-two.", "kw": "THE I"}},
    {"t": [260.0, 283.0], "tpl": "two_v",   "clips": [{"slug": "crane_cross_soldiers", "motion": "pushin", "cam": "arc"}, {"slug": "lots_dice_closeup", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "caption", "text": "This one is about me.", "kw": "ABOUT ME"}},
    {"t": [283.0, 302.0], "tpl": "big_inset","clips": [{"slug": "the_turn", "motion": "pushin"}, {"slug": "empty_tomb_open", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "caption", "text": "The song does not end in a grave. It turns.", "kw": "IT TURNS"}},
    {"t": [302.0, 320.0], "tpl": "big_inset","clips": [{"slug": "risen_worshipper", "motion": "pushin"}, {"slug": "risen_hands_raised", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "I will declare thy name unto my brethren: in the midst of the congregation will I praise thee.", "speaker": "RISEN CHRIST", "ref": "Hebrews 2:12"}},
    {"t": [320.0, 334.0], "tpl": "two_v",   "clips": [{"slug": "risen_hands_raised", "src": "new", "motion": "pushin", "cam": "arc"}, {"slug": "risen_worshipper", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "When he cried unto him, he heard.", "speaker": "PSALM 22", "ref": "v.24"}},
    {"t": [334.0, 355.0], "tpl": "big_inset","clips": [{"slug": "ends_of_earth", "motion": "pushin"}, {"slug": "nations_streaming_wide", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "All the ends of the world shall remember and turn unto the LORD.", "speaker": "PSALM 22", "ref": "v.27"}},
    {"t": [355.0, 371.0], "tpl": "big_inset","clips": [{"slug": "finished_work", "motion": "pushin"}, {"slug": "empty_tomb_open", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "redletter", "text": "It is finished.", "speaker": "JESUS", "ref": "John 19:30"}},
    {"t": [371.0, 393.2], "tpl": "big_inset","clips": [{"slug": "parting_storm_light", "motion": "pushin", "cam": "swoop"}, {"slug": "kneeling_at_cross", "src": "new", "motion": "pushin", "cam": "arc"}],
      "cap": {"type": "caption", "text": "The forsaking fell on him so it would never fall on you.", "kw": "NEVER FALL ON YOU"}},
    {"t": [393.2, 418.2], "tpl": "big_inset","clips": [{"slug": "risen_hero_come", "motion": "pushin"}, {"slug": "hand_reaching_closeup", "src": "new", "motion": "pushin", "cam": "arc"}],
