!_website/assets/og/
!_website/assets/og/**
!_website/assets/study/
!_website/assets/study/**
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg

# Asset library (media — lives in _library/, backed up to Drive, regenerable via _build_plates.py)
_library/

# scratch run logs (per-run, regenerable) — ALL logs + backups + terminal dumps (P0-5, 2026-07-08)
*.log
*.bak
/terminals/
.agent_bridge/_*.log
*.stackdump

# session work dirs (throwaway)
_assembly/
_sfx_work/

# local design comps demo media (served pages are the real site)
_website/_redesign/_media/

# archived (off-site) content, kept on disk only
archive/

# per-session cost-watcher state (cost_status.py hook)
data/.cost_state/

# per-session turn-wait state (cost_status.py --turn-hook) + watcher_service.py state
data/.turn_state/
data/.watcher.pid
data/.watcher_status.json

# local content-sha perf cache (pipeline/finality.py) — machine-local, regenerable
data/.sha_cache.json

# ffmpeg concat-list scratch (auto-generated per assembly run, absolute
# per-machine paths, point at the gitignored media above — no standalone
# value, regenerate freely; recurs under every episode's _assemble_work/
# _caption_segments/_mocomic_work-style build dirs)
*_concat.txt
_concat_all.txt
_concat_list.txt
_ep_concat.txt
