# ── Secrets / env ─────────────────────────────────────────────
.env
.env.*
*.key

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── IDE / OS ──────────────────────────────────────────────────
.idea/
.vscode/
*.stackdump
Thumbs.db
.DS_Store

# ── Agent-mode bridge (transient request/response/image files) ─
.agent_bridge/

# ── Local Claude Code session state + scratch (per-machine) ────
.claude/
_video_bakeoff/
_probe*.txt
_gitcheck.txt

# ── Awakeden site previews (committed for Netlify; production PNGs stay gitignored) ──
!_website/assets/previews/
!_website/assets/previews/**

# ── Awakeden internal docs/logs — never commit/deploy (Netlify publish dir is _website/.) ──
_website/_independent_review/
_website/COPY_REWRITE.md

# ── Media (per repo policy — code/data/docs only, no media) ────
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tiff

# Re-allow committed Awakeden site previews + share image (MUST come after the media ignores) ──
!_website/assets/previews/
!_website/assets/previews/**
!_website/assets/og-cover.jpg
!_website/assets/og/
!_website/assets/og/**
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg

# Asset library (media — lives in _library/, backed up to Drive, regenerable via _build_plates.py)
_library/

# scratch run logs (per-run, regenerable)
longform/**/_*.log
.agent_bridge/_*.log
/_*.log
*.stackdump
